#!/bin/bash
# playwright / run-test — launch playwright test in the component directory (cwd).
# The JSON is written to $SPRINT_RAW_DIR/result.json through PLAYWRIGHT_JSON_OUTPUT_NAME.
set -u
mkdir -p "$SPRINT_RAW_DIR"
export PLAYWRIGHT_JSON_OUTPUT_NAME="$SPRINT_RAW_DIR/result.json"
exec ./node_modules/.bin/playwright test --reporter=line,json "$@"
