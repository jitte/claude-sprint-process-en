#!/bin/bash
# node-vitest / run-test — launch vitest in the component directory (cwd).
# Put extra args (partial run) after the runner. The runner's JSON is written to $SPRINT_RAW_DIR/result.json.
# The exit code is that of vitest.
set -u
mkdir -p "$SPRINT_RAW_DIR"
exec ./node_modules/.bin/vitest run --reporter=default --reporter=json --outputFile="$SPRINT_RAW_DIR/result.json" "$@"
